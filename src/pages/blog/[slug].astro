    .article-content :global(table) { display: block; width: 100%; margin: 2rem 0; overflow-x: auto; border-collapse: collapse; color: var(--paper); background: var(--ink-soft); }
    .article-content :global(th), .article-content :global(td) { min-width: 130px; padding: 0.85rem 1rem; text-align: left; border-bottom: 1px solid var(--line-on-ink); }
    .article-content :global(th) { color: var(--paper); background: var(--surface-strong); }
    .article-content :global(td) { color: var(--text); }
    .article-content :global(hr) { margin: 3rem 0; border: 0; border-top: 1px solid var(--line-on-ink); }

    .page-toc { padding-left: 24px; border-left: 1px solid var(--line-on-ink); }
    .toc-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
    .toc-link { display: block; padding: 9px 0; color: var(--muted); font-size: 0.78rem; line-height: 1.45; border-bottom: 1px solid var(--line); }
    .toc-link:hover { color: var(--red); }
    .toc-link.depth-3 { padding-left: 14px; font-size: 0.73rem; }
    .toc-empty { color: var(--muted); font-size: 0.78rem; }
    .toc-back { display: inline-flex; align-items: center; gap: 8px; margin-top: 24px; color: var(--red); font-size: 0.8rem; }

    .article-navigation { grid-column: 2 / 3; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 14px; padding-top: 34px; border-top: 1px solid var(--line-on-ink); }
    .article-navigation.single { grid-template-columns: 1fr; }
    .article-nav-link { display: block; min-height: 118px; padding: 18px; background: var(--ink-soft); border-left: 2px solid var(--line-on-ink); transition: border-color 160ms ease, transform 160ms ease; }
    .article-nav-link:hover { border-color: var(--red); transform: translateY(-2px); }
    .article-nav-link:last-child { text-align: right; }
    .nav-direction { display: block; margin-bottom: 8px; color: var(--red); font-size: 0.72rem; }
    .nav-title { color: var(--paper); font-family: var(--display); font-size: 1rem; line-height: 1.3; }

    @media (max-width: 1180px) {
      .article-hero-grid { grid-template-columns: 190px minmax(0, 1fr); }
      .article-heading { grid-column: 2; }
      .reader-grid { grid-template-columns: 190px minmax(0, 780px); justify-content: center; }
      .page-toc { display: none; }
      .article-navigation { grid-column: 2; }
    }
    @media (max-width: 860px) {
      .article-hero { width: min(100% - 32px, 780px); padding: 108px 0 42px; }
      .article-hero-grid { grid-template-columns: 1fr; gap: 12px; }
      .article-kind { padding: 0; }
      .article-heading { grid-column: 1; }
      .article-title { font-size: clamp(2.45rem, 10vw, 4rem); }
      .reader-grid { grid-template-columns: 1fr; width: min(100% - 32px, 780px); padding: 42px 0 76px; }
      .article-meta { position: static; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 20px; padding-bottom: 28px; border-bottom: 1px solid var(--line-on-ink); }
      .article-meta .rail-title { display: none; }
      .meta-list { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0; }
      .meta-row { padding: 0; border: 0; }
      .article-actions { grid-template-columns: auto auto; }
      .share-button, .wechat-copy-button { width: auto; white-space: nowrap; }
      .article-navigation { grid-column: 1; }
    }
    @media (max-width: 560px) {
      .article-meta { grid-template-columns: 1fr; }
      .article-actions { grid-template-columns: 1fr; }
      .share-button, .wechat-copy-button { width: 100%; }
      .article-content { font-size: 1rem; line-height: 1.62; }
      .article-content :global(h2) { font-size: 1.65rem; }
      .article-content :global(pre) { margin-inline: -8px; padding: 1rem; border-radius: 8px; }
      .article-navigation { grid-template-columns: 1fr; }
      .article-nav-link:last-child { text-align: left; }
    }
  
    .share-button, .share-card-actions button.is-primary, .filter-button.active { color: #fff; background: #446d59; border-color: #446d59; }
    .share-button:hover, .share-button.copied, .share-card-actions button.is-primary:hover { color: #fff; background: #325441; border-color: #325441; }
</style>

  <article class="article-page">
    <header class="article-hero">
      <div class="article-hero-grid">
        <div class="article-kind">{siteConfig.blogTitle}</div>
        <div class="article-heading">
          <h1 class="article-title">{post.data.title}</h1>
          <p class="article-description">{post.data.description}</p>
        </div>
      </div>
    </header>

    <div class="reader-grid">
      <aside class="article-meta" aria-label="文章信息">
        <h2 class="rail-title">文章信息</h2>
        <dl class="meta-list">
          <div class="meta-row">
            <dt>发布日期</dt>
            <dd><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time></dd>
          </div>
          <div class="meta-row"><dt>作者</dt><dd>{post.data.author}</dd></div>
          {post.data.updatedAt && <div class="meta-row"><dt>更新日期</dt><dd><time datetime={updatedAt.toISOString()}>{updatedAt.toLocaleDateString('zh-CN')}</time></dd></div>}
          <div class="meta-row"><dt>预计阅读</dt><dd>{readingMinutes} 分钟</dd></div>
          <div class="meta-row">
            <dt>标签</dt>
            <dd class="article-tags">{post.data.tags.map((tag: string) => <span class="article-tag">{tag}</span>)}</dd>
          </div>
        </dl>
        <div class="article-actions">
          <a class="share-button" href={markdownPath}>阅读 Markdown</a>
          <button class="wechat-copy-button" type="button" onclick="copyArticleToWechat()">
            <i class="fab fa-weixin" aria-hidden="true"></i> 复制到公众号
          </button>
          <button class="wechat-copy-button" type="button" onclick="startImageCopyAssistant()">
            <i class="far fa-images" aria-hidden="true"></i> 逐张复制图片
          </button>
          <button class="share-button" type="button" onclick="shareArticle()">
            <i class="fas fa-share-alt" aria-hidden="true"></i> 分享文章
          </button>
        </div>
      </aside>

      <div class="article-content">
        <Content />
      </div>

      <aside class="page-toc" aria-label="页面目录">
        <h2 class="rail-title">页面目录</h2>
        {articleHeadings.length > 0 ? (
          <ol class="toc-list">
            {articleHeadings.map((heading) => (
              <li><a class:list={['toc-link', `depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        ) : <p class="toc-empty">本文暂无分节目录。</p>}
        <a class="toc-back" href="/blog"><i class="fas fa-arrow-left" aria-hidden="true"></i> 返回博客</a>
      </aside>

      {(newerPost || olderPost) && (
        <nav class:list={['article-navigation', { single: !(newerPost && olderPost) }]} aria-label="相邻文章">
          {newerPost && (
            <a class="article-nav-link" href={`/blog/${newerPost.slug}`}>
              <span class="nav-direction">较新文章</span>
              <span class="nav-title">{newerPost.data.title}</span>
            </a>
          )}
          {olderPost && (
            <a class="article-nav-link" href={`/blog/${olderPost.slug}`}>
              <span class="nav-direction">较早文章</span>
              <span class="nav-title">{olderPost.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>

  <SelectionShare
    contentSelector=".article-content"
    title={post.data.title}
    author={post.data.author}
    section={siteConfig.name}
    logo={siteConfig.logo}
    url={shareUrl}
  />
</Layout>
