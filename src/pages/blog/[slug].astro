---
import Layout from '../../layouts/Layout.astro';
import SelectionShare from '../../components/SelectionShare.astro';
import { getCollection } from 'astro:content';
import { canonicalUrl, articleSchema } from '../../lib/site-content';
import { siteConfig } from '../../../site.config.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft && post.data.pubDate && post.data.title && post.data.description)
    .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const articleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const posts = (await getCollection('blog'))
  .filter((entry) => !entry.data.draft && entry.data.pubDate)
  .sort((a, b) => {
    const po = (entry: { slug: string; data: { pubDate: Date } }) => {
      const rankMap: Record<string, number> = { concepts: 0, methods: 1, practice: 2 };
      const gm = entry.slug.match(/^k(\d+)/);
      const rm = entry.slug.match(/-(concepts|methods|practice)$/);
      return {
        group: gm ? parseInt(gm[1], 10) : 999,
        rank: rm ? rankMap[rm[1]] : 0,
        date: entry.data.pubDate.valueOf(),
        slug: entry.slug,
      };
    };
    const pa = po(a), pb = po(b);
    if (pa.group === 999 && pb.group === 999) return pa.date.valueOf() - pb.date.valueOf();
    if (pa.group === 999) return 1;
    if (pb.group === 999) return -1;
    return pb.group - pa.group || pa.rank - pb.rank || pa.date.valueOf() - pb.date.valueOf();
  });
const currentIndex = posts.findIndex((entry) => entry.slug === post.slug);
const newerPost = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const olderPost = currentIndex < posts.length - 1 ? posts[currentIndex + 1] : undefined;
const readingMinutes = Math.max(1, Math.ceil(post.body.replace(/\s/g, '').length / 500));
const shareDescription = `${post.data.description.slice(0, 50)}${post.data.description.length > 50 ? '...' : ''}`;
const shareUrl = canonicalUrl(Astro.url.pathname);
const updatedAt = post.data.updatedAt ?? post.data.pubDate;
const markdownPath = `/blog/${post.slug}/index.md`;
const markdownUrl = canonicalUrl(markdownPath);
const shareText = `${shareDescription}\n\n${shareUrl}`;
const wechatTitle = post.data.title;
const wechatDescription = post.data.description;
const wechatAuthor = post.data.author;
const wechatDate = post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title={`${post.data.title} - ${siteConfig.name}`}
  description={post.data.description}
  image={post.data.image || siteConfig.ogImage}
  imageWidth={post.data.image ? undefined : 1200}
  imageHeight={post.data.image ? undefined : 630}
  markdownUrl={markdownUrl}
  mathjax={post.data.mathjax}
  article={{ author: post.data.author, publishedAt: post.data.pubDate.toISOString(), updatedAt: updatedAt.toISOString() }}
  structuredData={[
    articleSchema({ title: post.data.title, description: post.data.description, url: shareUrl, author: post.data.author, image: post.data.image, publishedAt: post.data.pubDate, updatedAt, section: siteConfig.blogTitle }),
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: canonicalUrl('/') },
      { '@type': 'ListItem', position: 2, name: '博客', item: canonicalUrl('/blog/') },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: shareUrl },
    ] },
  ]}
>
  <script is:inline define:vars={{ shareText, shareUrl, wechatTitle, wechatDescription, wechatAuthor, wechatDate }}>
    window.shareArticle = async function () {
      const button = document.querySelector('button.share-button');
      try {
        await navigator.clipboard.writeText(shareText);
        if (!button) return;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i> 已复制';
        button.classList.add('copied');
        window.setTimeout(() => {
          button.innerHTML = originalText;
          button.classList.remove('copied');
        }, 2000);
      } catch (error) {
        console.error('复制失败', error);
        window.prompt('请复制下面的分享内容', shareText);
      }
    };

    const wechatCopiedProperties = [
      'color', 'background-color', 'font-family', 'font-size', 'font-weight', 'font-style',
      'line-height', 'letter-spacing', 'text-align', 'text-decoration', 'text-indent',
      'margin-top', 'margin-right', 'margin-bottom', 'margin-left',
      'padding-top', 'padding-right', 'padding-bottom', 'padding-left',
      'border-top', 'border-right', 'border-bottom', 'border-left', 'border-radius',
      'display', 'vertical-align',
      'white-space', 'list-style-type', 'border-collapse', 'overflow-wrap', 'word-break'
    ];

    const canonicalizeWechatUrl = function (value) {
      if (!value) return value;
      try {
        return new URL(value, shareUrl).href;
      } catch {
        return value;
      }
    };

    // 把文章里的图片转成 data URI（base64 直接嵌进富文本）。
    // 粘贴时图片数据随文本一起进公众号编辑器，微信不需要按 URL
    // 回源抓图——本地/占位域名阶段图片也能一键全部带过去。
    const imageUrlCache = new Map();

    const fetchArticleImage = async function (image) {
      const rawSource = image.getAttribute('src') || image.currentSrc || image.src;
      if (!rawSource) throw new Error('image has no src');
      const cached = imageUrlCache.get(rawSource);
      if (cached) return cached;
      const response = await fetch(rawSource);
      if (!response.ok) throw new Error('image fetch failed: ' + rawSource);
      const blob = await response.blob();
      const dataUrl = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result));
        reader.onerror = () => reject(new Error('readAsDataURL failed'));
        reader.readAsDataURL(blob);
      });
      imageUrlCache.set(rawSource, dataUrl);
      return dataUrl;
    };

    window.buildWechatRichText = async function () {
      const article = document.querySelector('.article-content');
      if (!article) throw new Error('article content not found');

      const articleImages = Array.from(article.querySelectorAll('img'));
      const imageDataUrls = await Promise.all(articleImages.map((image) => fetchArticleImage(image).catch((error) => {
        console.error(error);
        return null;
      })));

      const clone = article.cloneNode(true);
      const sourceNodes = [article, ...article.querySelectorAll('*')];
      const cloneNodes = [clone, ...clone.querySelectorAll('*')];

      // 公式节点必须先按 class 抓引用：下面的循环会把 class 属性摘掉，
      // 摘掉之后再 querySelectorAll('.formula-xxx') 就选不中了，分数的
      // flex-direction:column 也就补不回去（公众号里分数会变成左右并排）。
      const formulaBlocks = Array.from(clone.querySelectorAll('.formula-block'));
      const formulaFractions = Array.from(clone.querySelectorAll('.formula-frac'));
      const formulaNumerators = Array.from(clone.querySelectorAll('.formula-frac .num'));
      const formulaDenominators = Array.from(clone.querySelectorAll('.formula-frac .den'));
      // 根号节点同样要在 class 摘掉前抓引用：根号符号 + 上划线盖住被开方数，
      // 被开方数内的分数复用 formula-frac 竖式（2026-10-14 根号格式修复）。
      // 含分数的高根号在 class 还在时就把元素存进 tall 集合——不能用
      // data-* 属性中转，下面的通用清理循环会剥掉所有 data-* 属性；
      // Set 存在内存里不受清理影响。后面补样式按集合成员切换立骨画法。
      const formulaRadicals = Array.from(clone.querySelectorAll('.formula-radical'));
      const radicalTallSet = new Set(formulaRadicals.filter((node) => (node.getAttribute('class') || '').includes('formula-radical-tall')));
      const formulaRadicalSymbols = Array.from(clone.querySelectorAll('.formula-radical-symbol'));
      const formulaRadicalBodies = Array.from(clone.querySelectorAll('.formula-radical-body'));
      const formulaBlockSource = article.querySelector('.formula-block');

      const imageIndexByKey = new Map();
      articleImages.forEach((image, index) => {
        imageIndexByKey.set(image, index);
      });

      sourceNodes.forEach((sourceNode, index) => {
        const targetNode = cloneNodes[index];
        if (!(sourceNode instanceof Element) || !(targetNode instanceof Element)) return;

        const computed = getComputedStyle(sourceNode);
        const inlineStyles = wechatCopiedProperties
          .map((property) => `${property}:${computed.getPropertyValue(property)};`)
          .join('');

        targetNode.setAttribute('style', inlineStyles);
        targetNode.removeAttribute('id');
        targetNode.removeAttribute('class');
        [...targetNode.attributes].forEach((attribute) => {
          if (attribute.name.startsWith('data-') || attribute.name.startsWith('aria-')) {
            targetNode.removeAttribute(attribute.name);
          }
        });

        if (sourceNode instanceof HTMLImageElement && targetNode instanceof HTMLImageElement) {
          targetNode.removeAttribute('src');
          targetNode.removeAttribute('srcset');
          targetNode.removeAttribute('sizes');
          targetNode.removeAttribute('loading');
          targetNode.removeAttribute('decoding');
          const dataIndex = imageIndexByKey.get(sourceNode);
          const dataUrl = typeof dataIndex === 'number' ? imageDataUrls[dataIndex] : null;
          if (dataUrl) targetNode.setAttribute('src', dataUrl);
          targetNode.setAttribute('style', `${inlineStyles}display:block;width:100%;max-width:100%;height:auto;margin-left:auto;margin-right:auto;`);
        }

        if (sourceNode instanceof HTMLAnchorElement && targetNode instanceof HTMLAnchorElement) {
          targetNode.setAttribute('href', canonicalizeWechatUrl(sourceNode.getAttribute('href') || sourceNode.href));
          targetNode.removeAttribute('target');
          targetNode.removeAttribute('rel');
        }
      });

      clone.querySelectorAll('script, style, iframe, button, form, input, textarea, select').forEach((node) => node.remove());

      // MathJax 公式（tex-mml-chtml 的 chtml 输出）依赖动态 CSS，直接粘贴到
      // 公众号会被清洗器剥掉样式而错乱。这里把每个已渲染的 mjx-container 栅格化
      // 为 PNG 图片（html-to-image：把 MathJax 字体内嵌为 data URI，避免跨域
      // 污染），公众号里公式以图片显示，粘贴安全。旧 .formula-block 分支保留，
      // 兼容尚未改版的旧文。
      const liveMath = Array.from(article.querySelectorAll('mjx-container'));
      if (liveMath.length && typeof window.htmlToImage !== 'undefined') {
        try {
          if (window.MathJax && MathJax.startup && MathJax.startup.promise) await MathJax.startup.promise;
          await document.fonts.ready;
        } catch {}
        const cloneMath = Array.from(clone.querySelectorAll('mjx-container'));
        await Promise.all(liveMath.map(async (liveNode, index) => {
          const cloneNode = cloneMath[index];
          if (!cloneNode) return;
          let dataUrl;
          try {
            dataUrl = await window.htmlToImage.toPng(liveNode, { pixelRatio: 2, backgroundColor: null, cacheBust: false });
          } catch (error) { console.error('公式转图片失败', error); return; }
          if (!dataUrl) return;
          const display = liveNode.getAttribute('display') === 'true';
          const img = document.createElement('img');
          img.setAttribute('src', dataUrl);
          img.setAttribute('alt', liveNode.getAttribute('aria-label') || '公式');
          img.style.display = display ? 'block' : 'inline-block';
          img.style.margin = display ? '10px auto' : '0 2px';
          img.style.verticalAlign = 'middle';
          img.style.maxWidth = '100%';
          img.style.height = 'auto';
          cloneNode.replaceWith(img);
        }));
      }

      // 公式块的 class 已被上面的清理逻辑摘掉，样式需要手动补回。用循环前
      // 抓好的引用操作（此时已按 class 选不中元素）。
      // 主题色要在公式补样式前取好：分数线的颜色必须写死成具体色值，
      // 不能用 currentColor——公众号编辑器清洗后 currentColor 常变成
      // 无效值，整条分数线会跟着消失。
      const theme = getComputedStyle(document.documentElement);
      const palette = { bg: theme.getPropertyValue('--bg').trim(), text: theme.getPropertyValue('--text').trim(), muted: theme.getPropertyValue('--muted').trim(), accent: theme.getPropertyValue('--accent').trim() };

      const sourceComputed = formulaBlockSource ? getComputedStyle(formulaBlockSource) : null;
      formulaBlocks.forEach((node) => {
        if (!sourceComputed) return;
        const kept = ['font-family', 'font-size', 'font-style', 'line-height', 'text-align', 'margin-top', 'margin-bottom', 'padding-top', 'padding-bottom'];
        const inline = kept.map((property) => `${property}:${sourceComputed.getPropertyValue(property)};`).join('');
        node.setAttribute('style', `${inline}display:block;text-indent:0;overflow-x:auto;`);
        // 公众号粘贴会剥掉 div 标签本身：内容保留、div 上的样式全丢。
        // 把所有裸露内容包进带完整公式样式的 p，让样式跟着 p 走；
        // 循环结束后（见下方 formulaBlocks 替换段）外层 div 还会整体
        // 换成 section——section 在微信粘贴白名单里，容器样式能活下来。
        // 含分数的公式被拆平后内容裸露在 div 里（没有内层 p），粘贴后就
        // 失去居中和衬线字体——“公式不居中、字体不统一”就是这个原因。
        const carrierStyle = `${inline}text-indent:0;margin:0;`;
        let bareRun = [];
        const flushBare = () => {
          if (bareRun.length === 0) return;
          const carrier = document.createElement('p');
          carrier.setAttribute('style', carrierStyle);
          bareRun[0].parentNode?.insertBefore(carrier, bareRun[0]);
          bareRun.forEach((child) => carrier.appendChild(child));
          bareRun = [];
        };
        Array.from(node.childNodes).forEach((child) => {
          if (child instanceof HTMLParagraphElement) flushBare();
          else bareRun.push(child);
        });
        flushBare();
      });
      // p 包裹完成后，把公式块外层 div 整体换成 section：微信粘贴白名单
      // 没有 div，标签会被剥掉、容器样式（text-indent/overflow）全丢；
      // section 是公众号编辑器原生容器（各家排版工具也全用 section），
      // 粘贴安全（2026-10-17 修复，配合 smoke 的禁 div 断言）。
      formulaBlocks.forEach((node) => {
        if (node.parentNode && node.tagName === 'DIV') {
          const sectionCarrier = document.createElement('section');
          sectionCarrier.setAttribute('style', node.getAttribute('style') || '');
          while (node.firstChild) sectionCarrier.appendChild(node.firstChild);
          node.replaceWith(sectionCarrier);
        }
      });
      // 分数容器：分子在上、横线、分母在下。这里刻意不用 flex——公众号
      // 网页编辑器的粘贴清洗器会把 inline-flex/flex-direction 剥掉，粘贴
      // 后分子分母就左右并排了（flex 方案 2026-10-13 实测被洗掉）。
      // inline-block 外层 + 块级分子分母是各家排版工具验证过的粘贴安全做法。
      formulaFractions.forEach((node) => {
        node.setAttribute('style', 'display:inline-block;vertical-align:middle;text-align:center;margin:0 5px;line-height:1.4;');
      });
      // 分子：底部横线即分数线；display:block 让分子分母各占一行。
      formulaNumerators.forEach((node) => {
        node.setAttribute('style', `display:block;padding:0 6px 2px;border-bottom:2px solid ${palette.text};text-align:center;`);
      });
      formulaDenominators.forEach((node) => {
        node.setAttribute('style', 'display:block;padding:2px 6px 0;text-align:center;');
      });
      // 根号：公众号粘贴会剥 div，根号必须由自带样式的 span 承载。根号线是
      // 被开方数 span 的 border-top，颜色写具体值（currentColor 会被洗掉）。
      // 不用 flex；inline-block + border-top 是粘贴安全做法，与分数同一思路。
      // 与页面 CSS 双端同步（2026-10-22 重画）：符号与被开方数 vertical-align:top
      // 对齐到同一顶线、√ 竖臂顶端接住上边线，负 margin 让横线左端压住 √ 右臂
      // 连成一笔；去掉旧版 1.22em 放大 + 0.28em 顶垫的脱节补丁。高根号仍用
      // 立骨（被开方数加左边线撑满全高），√ 沉底当钩。√ 给衬线字体兜底，
      // 公众号里退化成系统衬线 √ 也能保证横线与钩衔接。
      formulaRadicals.forEach((node) => {
        node.setAttribute('style', 'display:inline-block;white-space:nowrap;vertical-align:middle;');
      });
      formulaRadicalSymbols.forEach((node, index) => {
        const tall = radicalTallSet.has(formulaRadicals[index]);
        node.setAttribute('style', tall
          ? `font-style:normal;display:inline-block;font-size:1em;line-height:1;vertical-align:-0.08em;padding:0;margin-right:-0.08em;color:${palette.text};font-family:'Times New Roman',serif;`
          : `font-style:normal;display:inline-block;font-size:1.08em;line-height:1;vertical-align:top;padding:0 0.01em 0 0.04em;margin-right:-0.12em;color:${palette.text};font-family:'Times New Roman',serif;`);
      });
      formulaRadicalBodies.forEach((node, index) => {
        const tall = radicalTallSet.has(formulaRadicals[index]);
        node.setAttribute('style', tall
          ? `display:inline-block;border-top:2px solid ${palette.text};border-left:2px solid ${palette.text};padding:0.05em 0.3em 0 0.28em;margin-left:0;line-height:1.16;text-align:center;`
          : `display:inline-block;border-top:2px solid ${palette.text};padding:0.06em 0.3em 0;line-height:1.18;vertical-align:top;text-align:center;`);
      });

      // 微信编辑器的内容栏比桌面文章窄。不要保留桌面布局计算出的固定宽高，
      // 否则图片缩小后父元素仍会占据原高度，文字换行后也可能互相覆盖。
      clone.querySelectorAll('p').forEach((paragraph) => {
        const onlyChild = paragraph.children.length === 1 ? paragraph.firstElementChild : null;
        if (onlyChild instanceof HTMLImageElement && !paragraph.textContent?.trim()) {
          paragraph.setAttribute('style', 'margin:24px 0 12px;padding:0;line-height:0;');
        }
      });

      clone.querySelectorAll('img').forEach((image) => {
        image.style.display = 'block';
        image.style.width = '100%';
        image.style.maxWidth = '100%';
        image.style.height = 'auto';
        image.style.marginLeft = 'auto';
        image.style.marginRight = 'auto';
      });

      clone.querySelectorAll('pre').forEach((pre) => {
        pre.style.display = 'block';
        pre.style.width = 'auto';
        pre.style.maxWidth = '100%';
        pre.style.whiteSpace = 'pre-wrap';
        pre.style.wordBreak = 'break-word';
        pre.style.overflowWrap = 'anywhere';
      });

      clone.querySelectorAll('pre code').forEach((code) => {
        code.style.whiteSpace = 'pre-wrap';
        code.style.wordBreak = 'break-word';
        code.style.overflowWrap = 'anywhere';
      });

      clone.querySelectorAll('table').forEach((table) => {
        table.style.display = 'table';
        table.style.width = '100%';
        table.style.maxWidth = '100%';
        table.style.tableLayout = 'fixed';
        table.style.borderCollapse = 'collapse';
      });

      clone.querySelectorAll('th, td').forEach((cell) => {
        cell.style.minWidth = '0';
        cell.style.wordBreak = 'break-word';
        cell.style.overflowWrap = 'anywhere';
        cell.style.verticalAlign = 'top';
      });

      // 兜底（2026-10-17）：公众号粘贴白名单没有 div，任何残留的 div
      // 都会被剥壳。文章容器（.article-content 本身是 div）和内层残留
      // div 一律换成 section。注意 clone 是游离树根、没有父节点，
      // replaceWith 对它是静默空操作——根节点分支必须用 while 搬子
      // 节点后把 wechatClone 指到新 section，之后统一用 wechatClone。
      let wechatClone = clone;
      const divCarriers = clone.tagName === 'DIV' ? [clone, ...clone.querySelectorAll('div')] : [...clone.querySelectorAll('div')];
      divCarriers.forEach((node) => {
        const sectionCarrier = document.createElement('section');
        sectionCarrier.setAttribute('style', node.getAttribute('style') || '');
        while (node.firstChild) sectionCarrier.appendChild(node.firstChild);
        if (node === clone) wechatClone = sectionCarrier;
        else node.replaceWith(sectionCarrier);
      });

      const wrapper = document.createElement('section');
      // 微信公众号编辑器内容栏自带左右安全内边距，wrapper 再叠水平 padding
      // 就是两层相加——粘贴后正文比正常文章窄一圈、和公众号原生版式对不齐
      // （2026-10-18 原老师反馈）。wrapper 只留上下节奏，左右归零让正文
      // 占满编辑器内容宽；行内元素自身的间距不受影响。
      wrapper.setAttribute('style', `box-sizing:border-box;width:100%;max-width:100%;margin:0;padding:24px 0;background-color:${palette.bg};color:${palette.text};font-family:PingFang SC,Microsoft YaHei,Helvetica Neue,Arial,Roboto,Segoe UI Symbol,sans-serif;font-size:16px;line-height:1.75;overflow-wrap:anywhere;word-break:break-word;`);

      // 标题块必须用 section 承载：微信编辑器粘贴白名单里没有 <header>，
      // header 标签会被整个剥壳，身上的下边框分隔线和间距全部丢失——
      // 「每次粘贴标题区都错位」就是它（2026-10-17 修复）。section 是
      // 公众号编辑器原生容器（各家排版工具也全用 section），粘贴安全。
      const header = document.createElement('section');
      header.setAttribute('style', `margin:0 0 34px;padding:0 0 24px;border-bottom:2px solid ${palette.accent};`);

      const title = document.createElement('h1');
      title.textContent = wechatTitle;
      title.setAttribute('style', `margin:0 0 18px;color:${palette.text};font-family:PingFang SC,Microsoft YaHei,Helvetica Neue,Arial,Roboto,Segoe UI Symbol,sans-serif;font-size:30px;font-weight:800;line-height:1.25;letter-spacing:-0.5px;`);

      const description = document.createElement('p');
      description.textContent = wechatDescription;
      // 摘要与作者行也要自带 font-family：粘贴后微信会给没写字体的文本套
      // 编辑器默认字体，和正文视觉不统一。
      description.setAttribute('style', `margin:0 0 16px;color:${palette.muted};font-family:PingFang SC,Microsoft YaHei,Helvetica Neue,Arial,Roboto,Segoe UI Symbol,sans-serif;font-size:16px;line-height:1.75;`);

      const meta = document.createElement('p');
      meta.textContent = `${wechatAuthor} · ${wechatDate}`;
      meta.setAttribute('style', `margin:0;color:${palette.accent};font-family:PingFang SC,Microsoft YaHei,Helvetica Neue,Arial,Roboto,Segoe UI Symbol,sans-serif;font-size:13px;font-weight:700;line-height:1.6;letter-spacing:0.5px;`);

      header.append(title, description, meta);
      wechatClone.setAttribute('style', `width:auto;max-width:100%;color:${palette.text};font-family:PingFang SC,Microsoft YaHei,Helvetica Neue,Arial,Roboto,Segoe UI Symbol,sans-serif;font-size:16px;line-height:1.75;overflow-wrap:anywhere;word-break:break-word;`);
      wrapper.append(header, wechatClone);

      return {
        html: wrapper.outerHTML,
        text: `${wechatTitle}\n\n${wechatDescription}\n\n${wechatAuthor} · ${wechatDate}\n\n${article.innerText}`
      };
    };

    const setWechatCopyFeedback = function (button, message, isError = false) {
      if (!button) return;
      const original = button.dataset.originalHtml ?? button.innerHTML;
      button.innerHTML = isError
        ? `<i class="fas fa-exclamation-circle" aria-hidden="true"></i> ${message}`
        : `<i class="fas fa-check" aria-hidden="true"></i> ${message}`;
      button.classList.toggle('copy-error', isError);
      button.classList.toggle('copied', !isError);
      window.setTimeout(() => {
        button.innerHTML = original;
        button.classList.remove('copied', 'copy-error');
      }, 2600);
    };

    window.copyArticleToWechat = async function () {
      const button = document.querySelector('.wechat-copy-button');
      // 原始文案必须在进入加载态之前缓存，否则"正在打包图片…"会被
      // 当成原始文案缓存住，之后每次反馈恢复都把按钮打回加载态。
      if (button && !button.dataset.originalHtml) {
        button.dataset.originalHtml = button.innerHTML;
      }
      try {
        if (button) {
          button.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> 正在打包图片…';
          button.disabled = true;
        }
        const payload = await window.buildWechatRichText();
        if (navigator.clipboard?.write && window.ClipboardItem && window.isSecureContext) {
          await navigator.clipboard.write([new ClipboardItem({
            'text/html': new Blob([payload.html], { type: 'text/html' }),
            'text/plain': new Blob([payload.text], { type: 'text/plain' })
          })]);
        } else {
          const holder = document.createElement('div');
          holder.contentEditable = 'true';
          holder.style.position = 'fixed';
          holder.style.left = '-99999px';
          holder.style.top = '0';
          holder.innerHTML = payload.html;
          document.body.appendChild(holder);

          const range = document.createRange();
          range.selectNodeContents(holder);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          const copied = document.execCommand('copy');
          selection?.removeAllRanges();
          holder.remove();
          if (!copied) throw new Error('copy command failed');
        }
        setWechatCopyFeedback(button, '已复制到公众号（含图）');
      } catch (error) {
        console.error('复制公众号富文本失败', error);
        setWechatCopyFeedback(button, '复制失败', true);
      } finally {
        if (button) button.disabled = false;
      }
    };

    // 公众号粘贴正文时，微信服务器会去图片源地址抓图转存；本地开发
    // (localhost) 或占位域名它访问不到，图片就会复制失败。这个助手把
    // 每张文章图以 PNG 位图写入剪贴板，粘贴时相当于本地上传，不依赖
    // 图片的可访问性。
    const imageAssistantState = { images: [], index: 0 };

    window.startImageCopyAssistant = function () {
      const images = Array.from(document.querySelectorAll('.article-content img'));
      if (images.length === 0) {
        window.alert('这篇文章没有插图。');
        return;
      }
      imageAssistantState.images = images;
      imageAssistantState.index = 0;
      renderImageAssistant();
    };

    function renderImageAssistant() {
      document.querySelector('.image-copy-overlay')?.remove();
      const { images, index } = imageAssistantState;
      const overlay = document.createElement('div');
      overlay.className = 'image-copy-overlay';
      overlay.setAttribute('style', 'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.55);padding:16px;');
      overlay.innerHTML = `
        <div role="dialog" aria-modal="true" aria-label="逐张复制图片" style="box-sizing:border-box;width:min(92vw,460px);max-height:86vh;overflow:auto;background:#fff;color:#1c221f;border-radius:14px;padding:22px 24px;font-family:PingFang SC,Microsoft YaHei,sans-serif;font-size:15px;line-height:1.7;">
          <p style="margin:0 0 6px;font-weight:700;font-size:17px;">第 ${index + 1} / ${images.length} 张</p>
          <p style="margin:0 0 14px;color:#5b6360;">图片已复制到剪贴板。切到公众号编辑器按 Ctrl+V 粘贴，再回来点下一张。</p>
          <img src="${images[index].currentSrc || images[index].src}" alt="" style="display:block;width:100%;max-height:300px;object-fit:contain;margin:0 0 16px;border:1px solid #e3e6e2;border-radius:8px;background:#f6f7f5;" />
          <div style="display:flex;gap:10px;justify-content:flex-end;">
            <button type="button" data-act="close" style="padding:9px 16px;border:1px solid #c9cdc9;border-radius:8px;background:#fff;color:#1c221f;font-size:14px;cursor:pointer;">关闭</button>
            ${index > 0 ? '<button type="button" data-act="prev" style="padding:9px 16px;border:1px solid #c9cdc9;border-radius:8px;background:#fff;color:#1c221f;font-size:14px;cursor:pointer;">上一张</button>' : ''}
            ${index < images.length - 1
              ? '<button type="button" data-act="next" style="padding:9px 16px;border:none;border-radius:8px;background:#2f5443;color:#fff;font-size:14px;cursor:pointer;">复制并下一张</button>'
              : '<button type="button" data-act="done" style="padding:9px 16px;border:none;border-radius:8px;background:#2f5443;color:#fff;font-size:14px;cursor:pointer;">完成</button>'}
          </div>
        </div>`;
      document.body.appendChild(overlay);
      overlay.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('button[data-act]') : null;
        if (!target) return;
        const act = target.getAttribute('data-act');
        if (act === 'close' || act === 'done') overlay.remove();
        if (act === 'prev') { imageAssistantState.index -= 1; renderImageAssistant(); }
        if (act === 'next') { imageAssistantState.index += 1; renderImageAssistant(); }
      });
      void copyArticleImage(images[index]);
    }

    async function copyArticleImage(image) {
      try {
        const bitmap = await loadImageBitmap(image.currentSrc || image.src);
        const canvas = document.createElement('canvas');
        canvas.width = bitmap.width;
        canvas.height = bitmap.height;
        canvas.getContext('2d').drawImage(bitmap, 0, 0);
        bitmap.close?.();
        const blob = await new Promise((resolve, reject) => canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('toBlob failed'))), 'image/png'));
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
      } catch (error) {
        console.error('复制图片失败', error);
        window.alert('这张图复制失败，请右键图片手动"复制图片"后继续。');
      }
    }

    function loadImageBitmap(url) {
      return new Promise((resolve, reject) => {
        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error('image load failed: ' + url));
        image.src = url;
      });
    }

  </script>

