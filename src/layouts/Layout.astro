---
import { canonicalUrl, jsonLd, SITE_NAME, SITE } from '../lib/site-content';
import { siteConfig } from '../../site.config.mjs';
import '../styles/theme.css';
import '../styles/noto-symbols2.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  markdownUrl?: string;
  article?: { publishedAt?: string; updatedAt?: string; author?: string };
  structuredData?: Record<string, unknown>[];
  mathjax?: boolean;
}
const {
  title = `${siteConfig.name} · ${siteConfig.role}`,
  description = siteConfig.description,
  image, imageWidth, imageHeight, noindex = false, markdownUrl, article, structuredData = [],
  mathjax = false,
} = Astro.props;
const ogImage = new URL(image || siteConfig.ogImage, SITE).href;
const ogUrl = canonicalUrl(Astro.url.pathname);
const pathname = Astro.url.pathname;
const signUrl = import.meta.env.WX_SIGN_URL || siteConfig.wechat.signUrl;
const siteSchema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: SITE_NAME, inLanguage: siteConfig.language },
  ...structuredData,
];
---
<!DOCTYPE html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eef0ed" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('site-theme');
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={ogUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/rss.xml" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    {markdownUrl && <link rel="alternate" type="text/markdown" title="Markdown 正文" href={markdownUrl} />}
    {!noindex && siteSchema.map((item) => <script is:inline type="application/ld+json" set:html={jsonLd(item)} />)}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article?.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt} />}
    {article?.author && <meta name="author" content={article.author} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    {(imageWidth || !image) && <meta property="og:image:width" content={String(imageWidth || 1200)} />}
    {(imageHeight || !image) && <meta property="og:image:height" content={String(imageHeight || 630)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {siteConfig.wechat.enabled && <>
      <script is:inline src="https://res.wx.qq.com/open/js/jweixin-1.6.0.js"></script>
      <script is:inline define:vars={{ signUrl, shareTitle: title, shareDesc: description, shareLink: ogUrl, shareImg: ogImage }}>
        (function () {
          if (typeof wx === 'undefined' || !/MicroMessenger/i.test(navigator.userAgent) || ['localhost', '127.0.0.1'].includes(location.hostname)) return;
          fetch(signUrl + '?url=' + encodeURIComponent(location.href.split('#')[0]))
            .then((r) => { if (!r.ok || !(r.headers.get('content-type') || '').includes('application/json')) throw new Error('wx-sign failed'); return r.json(); })
            .then((d) => {
              if (!d?.signature) return;
              wx.config({ debug: false, appId: d.appId, timestamp: d.timestamp, nonceStr: d.nonceStr, signature: d.signature, jsApiList: ['updateAppMessageShareData', 'updateTimelineShareData'] });
              wx.ready(() => {
                wx.updateAppMessageShareData({ title: shareTitle, desc: shareDesc, link: shareLink, imgUrl: shareImg });
                wx.updateTimelineShareData({ title: shareTitle, link: shareLink, imgUrl: shareImg });
              });
            }).catch((error) => console.error('wx-sign failed', error));
        })();
      </script>
    </>}
    {mathjax && <>
      <script is:inline>
        window.MathJax = {
          tex: { inlineMath: [['$', '$']], displayMath: [['$$', '$$']], processEscapes: true },
          chtml: { fontURL: '/vendor/mathjax/output/chtml/fonts/woff-v2', scale: 1 },
          startup: { typeset: true },
        };
      </script>
      <script is:inline src="/vendor/mathjax/tex-mml-chtml.js" async></script>
      <script is:inline src="/vendor/html-to-image/html-to-image.js" async></script>
    </>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <button class="theme-toggle" type="button" aria-label="切换明暗主题" aria-pressed="false" aria-describedby="theme-hint">
      <span class="theme-corner" aria-hidden="true"></span>
      <span class="theme-fold" aria-hidden="true"></span>
      <span class="theme-hint" id="theme-hint">翻到深色页</span>
    </button>
    <nav class="site-nav" aria-label="主导航">
      <div class="site-nav-inner">
        <a href="/" class="site-brand" aria-label={`${siteConfig.name}首页`}>
          <img src={siteConfig.logo} width="40" height="40" alt="" />
          <span>{siteConfig.name}<small>{siteConfig.role}</small></span>
        </a>
        <div class="nav-actions">
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-links" aria-label="打开导航菜单"><span></span><span></span><span></span></button>
        </div>
        <ul class="site-links" id="site-links">
          <li><a href="/" aria-current={pathname === '/' ? 'page' : undefined}>首页</a></li>
          <li><a href="/#about">关于</a></li>
          {siteConfig.home.projects.length > 0 && <li><a href="/#projects">作品</a></li>}
          <li><a href="/blog/" aria-current={pathname.startsWith('/blog') ? 'page' : undefined}>博客</a></li>
          <li><a href="/materials/" aria-current={pathname.startsWith('/materials') ? 'page' : undefined}>素材库</a></li>
          {siteConfig.home.contacts.length > 0 && <li><a href="/#contact">联系</a></li>}
        </ul>
      </div>
    </nav>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div><p class="footer-name">{siteConfig.name}</p><p>{siteConfig.description}</p></div>
        <div class="site-footer-links"><a href="/blog/">博客</a><a href="/rss.xml">RSS</a><a href="/llms.txt">Markdown 索引</a></div>
      </div>
      <div class="container footer-bottom">© {new Date().getFullYear()} {siteConfig.author}</div>
    </footer>
    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const menu = document.querySelector('.site-links');
      const closeMenu = () => {
        menuButton?.setAttribute('aria-expanded', 'false'); menu?.classList.remove('is-open'); document.body.style.overflow = '';
      };
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(open)); menu?.classList.toggle('is-open', open); document.body.style.overflow = open ? 'hidden' : '';
      });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
      matchMedia('(min-width: 769px)').addEventListener('change', closeMenu);
      const themeButton = document.querySelector('.theme-toggle');
      const syncThemeButton = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeButton?.setAttribute('aria-pressed', String(dark));
        const hint = document.querySelector('.theme-hint');
        if (hint) hint.textContent = dark ? '翻到浅色页' : '翻到深色页';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#171b19' : '#eef0ed');
      };
      syncThemeButton();
      let themeTransitionTimer;
      themeButton?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        clearTimeout(themeTransitionTimer);
        document.documentElement.classList.add('theme-changing');
        themeButton.classList.remove('is-turning');
        // Restart the small fold motion when readers toggle again quickly.
        void themeButton.offsetWidth;
        themeButton.classList.add('is-turning');
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('site-theme', next); } catch {}
        syncThemeButton();
        themeTransitionTimer = setTimeout(() => {
          document.documentElement.classList.remove('theme-changing');
          themeButton.classList.remove('is-turning');
        }, 520);
      });
    </script>
  </body>
</html>
