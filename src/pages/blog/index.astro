---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../../site.config.mjs';

const postOrder = (entry: { slug: string; data: { pubDate: Date } }) => {
  const rankMap: Record<string, number> = { concepts: 0, methods: 1, practice: 2 };
  const groupMatch = entry.slug.match(/^k(\d+)/);
  const rankMatch = entry.slug.match(/-(concepts|methods|practice)$/);
  return {
    group: groupMatch ? parseInt(groupMatch[1], 10) : 999,
    rank: rankMatch ? rankMap[rankMatch[1]] : 0,
    date: entry.data.pubDate.valueOf(),
    slug: entry.slug,
  };
};
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.pubDate)
  .sort((a, b) => {
    const pa = postOrder(a), pb = postOrder(b);
    return pa.group - pb.group || pa.rank - pb.rank || pa.date - pb.date || (pa.slug < pb.slug ? -1 : 1);
  });

const tagCounts = posts.flatMap((post) => post.data.tags).reduce<Record<string, number>>((counts, tag) => {
  counts[tag] = (counts[tag] || 0) + 1;
  return counts;
}, {});

const uniqueTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([tag, count]) => ({ tag, count }));
const popularTags = uniqueTags.slice(0, 6);
---

<Layout
  title={`${siteConfig.blogTitle} - ${siteConfig.name}`}
  description={siteConfig.blogDescription}
  image={siteConfig.ogImage}
  imageWidth={1200}
  imageHeight={630}
>
  <style>
    :global(html), :global(body) { max-width: 100%; overflow-x: clip; }
    :global(body) { background: var(--ink); }

    .blog-hero {
      position: relative;
      display: flex;
      align-items: end;
      min-height: 48dvh;
      padding: 142px 0 66px;
      overflow: hidden;
      color: var(--text-on-ink);
      background: radial-gradient(circle at 76% 42%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 34%), var(--ink);
    }
    .blog-hero-art {
      position: absolute;
      inset: 64px 0 0 48%;
      pointer-events: none;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%, #000 92%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 11%, #000 84%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(90deg, transparent 0%, #000 22%, #000 92%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 11%, #000 84%, transparent 100%);
      mask-composite: intersect;
    }
    .blog-hero-art img { width: 100%; height: 100%; object-fit: cover; opacity: 0.28; }
    .blog-hero-inner { position: relative; z-index: 1; width: min(100% - 64px, 1440px); margin-inline: auto; }
    .blog-title {
      max-width: 760px;
      margin-bottom: 18px;
      color: var(--text-on-ink);
      font-family: var(--display);
      font-size: clamp(2.6rem, 6vw, 5.2rem);
      line-height: 1.12;
      letter-spacing: -0.07em;
    }
    .blog-subtitle { max-width: 560px; margin: 0; color: var(--muted-on-ink); font-size: 1.05rem; }

    .blog-workspace {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr) 220px;
      gap: clamp(34px, 4.5vw, 72px);
      width: min(100% - 64px, 1440px);
      margin-inline: auto;
      padding: 70px 0 110px;
      color: var(--text-on-ink);
    }
    .blog-workspace > * { min-width: 0; }
    .filter-rail, .reading-rail { align-self: start; }
    .filter-panel, .reading-panel { position: sticky; top: 104px; }
    .rail-heading {
      margin-bottom: 18px;
      color: var(--paper);
      font-family: var(--display);
      font-size: 1.05rem;
      letter-spacing: -0.025em;
    }
    .search-box { position: relative; margin-bottom: 28px; }
    .search-icon { position: absolute; top: 50%; left: 16px; color: var(--red); transform: translateY(-50%); pointer-events: none; }
    .search-input {
      width: 100%;
      min-height: 50px;
      padding: 12px 14px 12px 44px;
      color: var(--text-on-ink);
      background: var(--ink-soft);
      border: 1px solid var(--line-on-ink);
      border-radius: 8px;
      font-size: 1rem;
    }
    .search-input::placeholder { color: var(--muted); }
    .search-input:focus { outline: 0; border-color: var(--red); box-shadow: 0 0 0 3px var(--accent-soft); }
    .tag-filter { padding-top: 26px; border-top: 1px solid var(--line-on-ink); }
    .tag-filter-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .tag-filter-header .rail-heading { margin: 0; }
    .tag-actions { display: flex; align-items: center; gap: 12px; }
    .clear-tags { display: none; padding: 0; color: var(--red); background: transparent; border: 0; cursor: pointer; font-size: 0.78rem; }
    .clear-tags.visible { display: inline; }
    .tag-toggle { display: none; padding: 0; color: var(--muted); background: transparent; border: 0; cursor: pointer; font-size: 0.78rem; }
    .tag-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .filter-button {
      padding: 7px 10px;
      color: var(--muted);
      background: transparent;
      border: 1px solid var(--line-on-ink);
      border-radius: 7px;
      cursor: pointer;
      font-size: 0.78rem;
      transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 160ms ease;
    }
    .filter-button:hover { color: var(--paper); border-color: var(--red); }
    .filter-button:active { transform: translateY(1px); }
    .filter-button.active { color: var(--paper); background: var(--red); border-color: var(--red); }
    .filter-count { margin-left: 4px; opacity: 0.62; }

    .blog-feed { min-width: 0; }
    .results-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      min-height: 48px;
      padding-bottom: 18px;
      border-bottom: 2px solid var(--red);
    }
    .results-count { color: var(--muted-on-ink); font-size: 0.86rem; }
    .results-count strong { color: var(--red); }
    .page-range { color: var(--muted); font-size: 0.78rem; }
    .active-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
    .active-filters:empty { display: none; }
    .active-filters :global(.active-filter) {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 34px;
      padding: 0 10px;
      color: var(--text);
      background: var(--ink-soft);
      border: 1px solid var(--line-on-ink);
      border-left: 2px solid var(--red);
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.75rem;
      font-weight: 700;
      transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 160ms ease;
    }
    .active-filters :global(.active-filter::before) { content: "#"; color: var(--red); font-weight: 800; }
    .active-filters :global(.active-filter::after) { content: "×"; color: var(--muted); font-size: 0.9rem; transition: color 160ms ease, transform 160ms ease; }
    .active-filters :global(.active-filter:hover) { color: var(--paper); background: var(--surface-strong); border-color: var(--red); transform: translateY(-1px); }
    .active-filters :global(.active-filter:hover::after) { color: var(--paper); transform: scale(1.08); }
    .active-filters :global(.active-filter:active) { transform: translateY(1px); }
    .posts-list { display: grid; }
    .post-card {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr) auto;
      gap: 12px 30px;
      align-items: start;
      padding: 34px 0;
      color: var(--text-on-ink);
      border-bottom: 1px solid var(--line-on-ink);
      transition: transform 180ms ease, border-color 180ms ease;
    }
    .post-card:hover { border-color: var(--red); transform: translateX(6px); }
    .post-card[hidden] { display: none; }
    .post-date { grid-column: 1; color: var(--red); font-size: 0.8rem; font-weight: 700; }
    .post-body { grid-column: 2; min-width: 0; }
    .post-title {
      margin-bottom: 12px;
      color: var(--paper);
      font-family: var(--display);
      font-size: clamp(1.55rem, 2.25vw, 2.35rem);
      line-height: 1.08;
      letter-spacing: -0.04em;
      overflow-wrap: anywhere;
    }
    .post-description { max-width: 760px; margin-bottom: 17px; color: var(--muted-on-ink); font-size: 0.94rem; line-height: 1.7; overflow-wrap: anywhere; }
    .post-tags { display: flex; flex-wrap: wrap; gap: 5px 12px; }
    .post-tag { color: var(--muted); font-size: 0.74rem; }
    .post-tag::before { content: "#"; color: var(--red); }
    .post-tag.active { color: var(--red); }
    .post-arrow { grid-column: 3; grid-row: 1 / span 2; align-self: center; color: var(--red); font-size: 1.15rem; transition: transform 180ms ease; }
    .post-card:hover .post-arrow { transform: translateX(4px); }

    .pagination {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 18px;
      margin-top: 34px;
      padding-top: 26px;
      border-top: 1px solid var(--line-on-ink);
    }
    .pagination[hidden] { display: none; }
    .page-button {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      min-height: 44px;
      padding: 0 15px;
      color: var(--paper);
      background: var(--ink-soft);
      border: 1px solid var(--line-on-ink);
      border-radius: 7px;
      cursor: pointer;
      font-weight: 700;
    }
    .page-button:last-child { justify-self: end; }
    .page-button:hover:not(:disabled) { border-color: var(--red); }
    .page-button:active:not(:disabled) { transform: translateY(1px); }
    .page-button:disabled { color: var(--muted); cursor: not-allowed; opacity: 0.7; }
    .page-status { color: var(--muted-on-ink); font-size: 0.82rem; white-space: nowrap; }
    .page-status strong { color: var(--paper); }
    .empty-state { padding: 70px 24px; text-align: center; color: var(--muted-on-ink); }
    .empty-state[hidden] { display: none; }
    .empty-state h2 { margin-bottom: 8px; color: var(--paper); font-family: var(--display); font-size: 1.7rem; }

    .reading-panel { padding-left: 24px; border-left: 1px solid var(--line-on-ink); }
    .reading-stat { margin-bottom: 28px; }
    .reading-number { display: block; margin-bottom: 5px; color: var(--paper); font-family: var(--display); font-size: 2.5rem; line-height: 1; }
    .reading-label { color: var(--muted-on-ink); font-size: 0.76rem; }
    .reading-links { display: grid; gap: 0; margin-bottom: 30px; }
    .reading-link { padding: 12px 0; color: var(--muted); background: transparent; border: 0; border-bottom: 1px solid var(--line-on-ink); cursor: pointer; font-size: 0.82rem; text-align: left; }
    .reading-link:hover { color: var(--red); }
    .playbook-link { display: block; padding: 18px; color: var(--paper); background: var(--ink-soft); border-left: 2px solid var(--red); }
    .playbook-link strong { display: block; margin-bottom: 5px; font-family: var(--display); font-size: 1rem; }
    .playbook-link span { color: var(--muted-on-ink); font-size: 0.76rem; line-height: 1.55; }

    @media (max-width: 1160px) {
      .blog-workspace { grid-template-columns: 240px minmax(0, 1fr); }
      .reading-rail { display: none; }
    }
    @media (max-width: 820px) {
      .blog-hero { min-height: 50dvh; padding: 110px 0 48px; }
      .blog-hero-art { inset: 64px -28% 0 0; opacity: 0.56; -webkit-mask-image: linear-gradient(180deg, transparent, #000 12%, #000 84%, transparent); mask-image: linear-gradient(180deg, transparent, #000 12%, #000 84%, transparent); }
      .blog-hero-inner { width: min(100% - 32px, 1440px); }
      .blog-title { font-size: clamp(3.3rem, 17vw, 5.4rem); }
      .blog-workspace { grid-template-columns: 1fr; width: min(100% - 32px, 760px); padding: 40px 0 76px; }
      .filter-panel { position: static; }
      .search-box { margin-bottom: 20px; }
      .tag-filter { padding-top: 18px; }
      .tag-list { flex-wrap: wrap; overflow: visible; }
      .tag-list:not(.expanded) .filter-button[data-extra-tag="true"] { display: none; }
      .tag-toggle { display: inline; }
      .blog-feed { padding-top: 4px; }
      .post-card { grid-template-columns: 1fr auto; gap: 12px 18px; padding: 28px 0; }
      .post-date { grid-column: 1; }
      .post-body { grid-column: 1 / -1; }
      .post-arrow { grid-column: 2; grid-row: 1; }
    }
    @media (max-width: 520px) {
      .results-info { align-items: flex-start; flex-direction: column; gap: 4px; }
      .post-title { font-size: 1.55rem; }
      .pagination { grid-template-columns: 1fr 1fr; }
      .page-status { grid-column: 1 / -1; grid-row: 1; text-align: center; }
      .page-button { justify-content: center; }
    }
  
    .share-button, .share-card-actions button.is-primary, .filter-button.active { color: #fff; background: #446d59; border-color: #446d59; }
    .share-button:hover, .share-button.copied, .share-card-actions button.is-primary:hover { color: #fff; background: #325441; border-color: #325441; }
</style>

  <header class="blog-hero">
    <div class="blog-hero-art" aria-hidden="true">
      <img src="/site-assets/teacher-desk-tired.png" alt="" width="1536" height="1024" fetchpriority="high" />
    </div>
    <div class="blog-hero-inner">
      <h1 class="blog-title">{siteConfig.blogTitle}</h1>
      <p class="blog-subtitle">{siteConfig.blogDescription}</p>
    </div>
  </header>

  <div class="blog-workspace">
    <aside class="filter-rail" aria-label="文章筛选">
      <div class="filter-panel">
        <h2 class="rail-heading">搜索文章</h2>
        <div class="search-box">
          <i class="fas fa-search search-icon" aria-hidden="true"></i>
          <input type="search" id="searchInput" aria-label="搜索文章标题、描述或标签" class="search-input" placeholder="标题、描述或标签" autocomplete="off" />
        </div>
        <div class="tag-filter">
          <div class="tag-filter-header">
            <h2 class="rail-heading">按标签筛选</h2>
            <div class="tag-actions">
              <button id="clearTags" class="clear-tags" type="button">清除</button>
              <button id="toggleTags" class="tag-toggle" type="button" aria-expanded="false" aria-controls="tagList">更多标签</button>
            </div>
          </div>
          <div class="tag-list" id="tagList">
            {uniqueTags.map(({ tag, count }, index) => (
              <button class="filter-button" type="button" data-tag={tag.toLowerCase()} data-label={tag} data-extra-tag={index >= 8 ? 'true' : undefined} aria-pressed="false">
                {tag}<span class="filter-count">{count}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </aside>

    <main class="blog-feed">
      <div class="results-info" id="resultsInfo">
        <span class="results-count">共 <strong id="resultsCount">{posts.length}</strong> 篇文章</span>
        <span class="page-range" id="pageRange"></span>
      </div>
      <div class="active-filters" id="activeFilters" aria-live="polite"></div>

      <div class="posts-list" id="postsList">
        {posts.map((post) => {
          const tagList = post.data.tags.map((tag: string) => tag.toLowerCase()).join('|||');
          return (
            <a
              href={`/blog/${post.slug}`}
              class="post-card"
              data-title={post.data.title.toLowerCase()}
              data-description={post.data.description.toLowerCase()}
              data-tag-list={tagList}
            >
              <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </time>
              <div class="post-body">
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-description">{post.data.description}</p>
                <div class="post-tags">
                  {post.data.tags.map((tag: string) => <span class="post-tag" data-tag={tag.toLowerCase()}>{tag}</span>)}
                </div>
              </div>
              <i class="fas fa-arrow-right post-arrow" aria-hidden="true"></i>
            </a>
          );
        })}
      </div>

      <div class="empty-state" id="emptyState" hidden>
        <h2>没有找到匹配文章</h2>
        <p>请调整搜索词或清除部分标签。</p>
      </div>

      <nav class="pagination" id="pagination" aria-label="文章分页">
        <button class="page-button" id="previousPage" type="button">
          <i class="fas fa-arrow-left" aria-hidden="true"></i> 上一页
        </button>
        <span class="page-status">第 <strong id="currentPage">1</strong> / <span id="totalPages">1</span> 页</span>
        <button class="page-button" id="nextPage" type="button">
          下一页 <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </button>
      </nav>
    </main>

    <aside class="reading-rail" aria-label="阅读入口">
      <div class="reading-panel">
        <h2 class="rail-heading">阅读索引</h2>
        <div class="reading-stat">
          <strong class="reading-number">{posts.length}</strong>
          <span class="reading-label">篇公开文章</span>
        </div>
        <nav class="reading-links" aria-label="热门专题">
          {popularTags.map(({ tag, count }) => (
            <button class="reading-link" type="button" data-quick-tag={tag.toLowerCase()}>{tag} ({count})</button>
          ))}
        </nav>
        <a class="playbook-link" href="/llms.txt">
          <strong>Markdown 阅读索引</strong>
          <span>全部公开文章的纯文本入口。</span>
        </a>
      </div>
    </aside>
  </div>

  <script is:inline>
    const PAGE_SIZE = 8;
    const searchInput = document.getElementById('searchInput');
    const postsList = document.getElementById('postsList');
    const cards = Array.from(document.querySelectorAll('.post-card'));
    const emptyState = document.getElementById('emptyState');
    const resultsCount = document.getElementById('resultsCount');
    const pageRange = document.getElementById('pageRange');
    const activeFilters = document.getElementById('activeFilters');
    const clearTags = document.getElementById('clearTags');
    const toggleTags = document.getElementById('toggleTags');
    const tagList = document.getElementById('tagList');
    const pagination = document.getElementById('pagination');
    const previousPage = document.getElementById('previousPage');
    const nextPage = document.getElementById('nextPage');
    const currentPageLabel = document.getElementById('currentPage');
    const totalPagesLabel = document.getElementById('totalPages');
    const resultsInfo = document.getElementById('resultsInfo');

    const requestedPage = Number(new URL(window.location.href).searchParams.get('page')) || 1;
    const tagLabels = new Map(Array.from(document.querySelectorAll('.filter-button')).map((button) => [button.dataset.tag, button.dataset.label]));
    let currentPage = Math.max(1, requestedPage);
    let searchQuery = '';
    const selectedTags = new Set();
    // 支持从首页板块导航跳转过来：?tag=力学 预筛选对应标签。
    const requestedTag = new URL(window.location.href).searchParams.get('tag');
    if (requestedTag) {
      const normalized = requestedTag.trim().toLowerCase();
      if (tagLabels.has(normalized)) selectedTags.add(normalized);
    }

    const matchesFilters = (card) => {
      const title = card.dataset.title || '';
      const description = card.dataset.description || '';
      const tags = (card.dataset.tagList || '').split('|||').filter(Boolean);
      const matchesSearch = !searchQuery || title.includes(searchQuery) || description.includes(searchQuery) || tags.some((tag) => tag.includes(searchQuery));
      const matchesTags = selectedTags.size === 0 || tags.some((tag) => selectedTags.has(tag));
      return matchesSearch && matchesTags;
    };

    const syncUrl = () => {
      const url = new URL(window.location.href);
      if (currentPage > 1) url.searchParams.set('page', String(currentPage));
      else url.searchParams.delete('page');
      // 预筛选标签已被用户主动改变时不再回写，避免刷新后筛选状态与地址栏不一致。
      const initialTag = url.searchParams.get('tag');
      if (initialTag !== null && !selectedTags.has(initialTag.trim().toLowerCase())) url.searchParams.delete('tag');
      window.history.replaceState({}, '', url);
    };

    const updateFilterControls = () => {
      document.querySelectorAll('[data-tag]').forEach((element) => {
        const active = selectedTags.has(element.dataset.tag || '');
        element.classList.toggle('active', active);
        if (element.classList.contains('filter-button')) element.setAttribute('aria-pressed', String(active));
      });
      activeFilters.innerHTML = '';
      selectedTags.forEach((tag) => {
        const label = tagLabels.get(tag) || tag;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'active-filter';
        button.dataset.removeTag = tag;
        button.textContent = label;
        button.setAttribute('aria-label', `移除标签 ${label}`);
        activeFilters.appendChild(button);
      });
      clearTags.classList.toggle('visible', selectedTags.size > 0);
    };

    const render = () => {
      const filtered = cards.filter(matchesFilters);
      const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
      currentPage = Math.min(Math.max(1, currentPage), totalPages);
      const start = (currentPage - 1) * PAGE_SIZE;
      const visible = new Set(filtered.slice(start, start + PAGE_SIZE));

      cards.forEach((card) => { card.hidden = !visible.has(card); });
      postsList.hidden = filtered.length === 0;
      emptyState.hidden = filtered.length !== 0;
      pagination.hidden = filtered.length === 0;
      resultsCount.textContent = String(filtered.length);
      currentPageLabel.textContent = String(currentPage);
      totalPagesLabel.textContent = String(totalPages);
      pageRange.textContent = filtered.length ? `显示 ${start + 1}-${Math.min(start + PAGE_SIZE, filtered.length)} 篇` : '';
      previousPage.disabled = currentPage === 1;
      nextPage.disabled = currentPage === totalPages;
      updateFilterControls();
      syncUrl();
    };

    const toggleTag = (tag) => {
      if (selectedTags.has(tag)) selectedTags.delete(tag);
      else selectedTags.add(tag);
      currentPage = 1;
      render();
    };

    searchInput.addEventListener('input', (event) => {
      searchQuery = event.target.value.trim().toLowerCase();
      currentPage = 1;
      render();
    });
    document.addEventListener('click', (event) => {
      const tagButton = event.target.closest('.filter-button, [data-quick-tag]');
      if (tagButton) toggleTag(tagButton.dataset.tag || tagButton.dataset.quickTag);

      const postTag = event.target.closest('.post-tag');
      if (postTag) {
        event.preventDefault();
        toggleTag(postTag.dataset.tag);
      }

      const removeButton = event.target.closest('[data-remove-tag]');
      if (removeButton) {
        selectedTags.delete(removeButton.dataset.removeTag);
        currentPage = 1;
        render();
      }
    });
    clearTags.addEventListener('click', () => {
      selectedTags.clear();
      currentPage = 1;
      render();
    });
    toggleTags.addEventListener('click', () => {
      const expanded = tagList.classList.toggle('expanded');
      toggleTags.setAttribute('aria-expanded', String(expanded));
      toggleTags.textContent = expanded ? '收起标签' : '更多标签';
    });
    previousPage.addEventListener('click', () => {
      if (currentPage <= 1) return;
      currentPage -= 1;
      render();
      resultsInfo.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });
    nextPage.addEventListener('click', () => {
      currentPage += 1;
      render();
      resultsInfo.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });

    render();
  </script>
</Layout>
