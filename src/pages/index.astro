---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../site.config.mjs';
const home = siteConfig.home;
const posts = (await getCollection('blog')).filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);

// 教材板块导航：tag 与文章 frontmatter 的板块标签保持一致，点击跳转博客列表并自动筛选。
const TOPICS = [
  { name: '力学', tag: '力学', icon: 'fas fa-gears', desc: '运动学、相互作用、牛顿定律、曲线运动与机械能' },
  { name: '热学', tag: '热学', icon: 'fas fa-fire', desc: '分子动理论、气体、内能与热力学定律' },
  { name: '电磁学', tag: '电磁学', icon: 'fas fa-bolt', desc: '静电场、电路、磁场、电磁感应与交流电' },
  { name: '光学', tag: '光学', icon: 'fas fa-lightbulb', desc: '几何光学、光的波动性与物理光学' },
  { name: '近代物理', tag: '近代物理', icon: 'fas fa-atom', desc: '量子初步、原子结构与原子核' },
  { name: '方法与工具', tag: '方法与工具', icon: 'fas fa-compass', desc: '解题方法、受力分析、图像与数学工具' },
];
---
<Layout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">{home.eyebrow}</p>
        <h1>{home.headline.map((line) => <span>{line}</span>)}</h1>
        <p class="hero-lead">{home.lead}</p>
        <a class="primary-link" href="/blog/">阅读博客 <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-visual">
        <button class="portrait-stage" type="button" aria-label="切换老师角色画面，当前第 1 张">
          {home.portraits.map((portrait, index) => <img class:list={['hero-character', { 'is-active': index === 0 }]} src={portrait.src} alt={portrait.alt} width={index === 0 ? 1536 : 1024} height={index === 0 ? 1024 : 1536} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />)}
        </button>
        <p class="portrait-hint">点击老师，换个姿势</p>
      </div>
    </div>
  </section>

  <section class="about section-space" id="about">
    <div class="container about-grid reveal">
      <h2>{home.aboutTitle}</h2>
      <div>{home.about.map((paragraph) => <p>{paragraph}</p>)}</div>
    </div>
  </section>

  {home.projects.length > 0 && <section class="section-space" id="projects">
    <div class="container">
      <header class="section-heading reveal"><h2>作品与实践</h2></header>
      <div class="project-list">
        {home.projects.map((project) => <a class="project-item reveal" href={project.href} target={project.href.startsWith('http') ? '_blank' : undefined} rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          {project.image && <img src={project.image} alt="" width="640" height="400" loading="lazy" />}
          <div><h3>{project.title}</h3><p>{project.description}</p></div><span aria-hidden="true">↗</span>
        </a>)}
      </div>
    </div>
  </section>}

  {home.capabilities.length > 0 && <section class="section-space skills" id="skills">
    <div class="container skills-grid">
      <div class="skills-art reveal"><img src="/site-assets/teacher-board-write.png" alt="手绘物理老师在黑板前讲解" width="1024" height="1536" loading="lazy" /></div>
      <div class="reveal"><header class="section-heading"><h2>关注的方向</h2></header>
        <div class="capability-list">{home.capabilities.map((capability) => <section><h3>{capability.title}</h3><ul>{capability.items.map((item) => <li>{item}</li>)}</ul></section>)}</div>
      </div>
    </div>
  </section>}

  <section class="section-space topics" id="topics">
    <div class="container">
      <header class="section-heading reveal"><h2>按教材板块找文章</h2><a href="/blog/">全部文章 →</a></header>
      <p class="topics-lead reveal">高中物理一共这么几摊事，哪块没想明白就点进去看，文章会按板块归好类。</p>
      <div class="topic-grid reveal">
        {TOPICS.map((topic) => <a class="topic-card" href={`/blog/?tag=${encodeURIComponent(topic.tag)}`}>
          <span class="topic-icon" aria-hidden="true"><i class={topic.icon}></i></span>
          <span class="topic-name">{topic.name}</span>
          <span class="topic-desc">{topic.desc}</span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="section-space writing">
    <div class="container">
      <header class="section-heading reveal"><h2>最近的记录</h2><a href="/blog/">全部文章 →</a></header>
      <div class="writing-list reveal">
        {posts.map((post) => <a class="writing-item" href={`/blog/${post.slug}/`}>
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
          <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span aria-hidden="true">↗</span>
        </a>)}
        {posts.length === 0 && <p class="empty-writing">这里还没有公开文章，新的记录会出现在这里。</p>}
      </div>
    </div>
  </section>

  {home.contacts.length > 0 && <section class="section-space contact" id="contact"><div class="container reveal">
    <h2>保持联系</h2><div class="contact-links">{home.contacts.map((contact) => <a href={contact.href}>{contact.label} ↗</a>)}</div>
  </div></section>}

  <script>
    const characters = Array.from(document.querySelectorAll<HTMLElement>('.hero-character'));
    const stage = document.querySelector<HTMLButtonElement>('.portrait-stage');
    let active = 0;
    stage?.addEventListener('click', () => {
      if (characters.length < 2) return;
      active = (active + 1) % characters.length;
      characters.forEach((image, index) => image.classList.toggle('is-active', index === active));
      stage.setAttribute('aria-label', `切换老师角色画面，当前第 ${active + 1} 张，共 ${characters.length} 张`);
    });
    const items = document.querySelectorAll<HTMLElement>('.reveal');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) items.forEach((item) => item.classList.add('is-visible'));
    else {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }), { threshold: .08 });
      items.forEach((item) => observer.observe(item));
      window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
    }
  </script>
  <style>
    .hero { overflow: hidden; border-bottom: 1px solid var(--line); }
    .hero-grid { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: center; min-height: min(820px, 94dvh); padding: 122px 0 48px; gap: 30px; }
    .hero-copy { position: relative; z-index: 1; max-width: 580px; }
    .hero-eyebrow { margin-bottom: 22px; color: var(--accent-strong); font-size: .8rem; letter-spacing: .12em; }
    h1 { margin-bottom: 26px; font-size: clamp(2.5rem, 4.6vw, 4.7rem); line-height: 1.18; letter-spacing: -.055em; }
    h1 span { display: block; }
    h1 span:last-child { color: var(--accent-strong); }
    .hero-lead { max-width: 440px; font-size: 1.05rem; color: var(--muted); margin-bottom: 30px; }
    .primary-link { display: inline-flex; align-items: center; gap: 20px; min-height: 48px; padding: 8px 24px; border-radius: 999px; background: #446d59; color: #fff; font-size: .9rem; font-weight: 600; }
    .primary-link:hover { background: #325441; }
    .hero-visual { min-width: 0; position: relative; }
    .portrait-stage { position: relative; display: block; width: 100%; height: 560px; padding: 0; border: 0; background: transparent; }
    .hero-character { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity 300ms ease; }
    .hero-character.is-active { opacity: 1; }
    .portrait-hint { text-align: center; font-size: .7rem; color: var(--muted); margin: 0; }
    .section-space { padding: 88px 0; scroll-margin-top: 80px; }
    h2 { font-size: clamp(1.7rem, 3vw, 2.75rem); letter-spacing: -.04em; line-height: 1.3; margin-bottom: 24px; }
    h3 { font-size: 1.15rem; line-height: 1.5; margin-bottom: 10px; }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; }
    .about-grid p { color: var(--muted); max-width: 560px; }
    .skills { background: var(--surface); border-block: 1px solid var(--line); }
    .skills-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: center; }
    .skills-art img { width: 100%; height: auto; max-height: 520px; object-fit: contain; }
    .capability-list { display: grid; gap: 24px; }
    .capability-list section { display: grid; grid-template-columns: 120px 1fr; gap: 20px; border-bottom: 1px solid var(--line); padding-bottom: 20px; }
    .capability-list ul { list-style: none; margin: 0; padding: 0; color: var(--muted); font-size: .9rem; }
    .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
    .section-heading h2 { margin: 0; }.section-heading a { color: var(--accent-strong); font-size: .86rem; }
    .topics-lead { max-width: 560px; margin: 0 0 28px; color: var(--muted); }
    .topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .topic-card {
      display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 14px;
      padding: 20px 22px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface);
      transition: border-color 180ms ease, transform 180ms ease, background 180ms ease;
    }
    .topic-card:hover { border-color: var(--accent); background: var(--accent-soft); transform: translateY(-3px); }
    .topic-icon { grid-row: 1 / span 2; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft); color: var(--accent-strong); font-size: 1.1rem; }
    .topic-card:hover .topic-icon { background: var(--surface); }
    .topic-name { font-weight: 700; font-size: 1.02rem; }
    .topic-desc { grid-column: 2; margin-top: 3px; color: var(--muted); font-size: .78rem; line-height: 1.55; }
    @media (max-width: 900px) { .topic-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .topic-grid { grid-template-columns: 1fr; } }
    .writing-item { display: grid; grid-template-columns: 120px minmax(0, 1fr) 24px; gap: 30px; padding: 30px 0; border-top: 1px solid var(--line); }
    .writing-item time { color: var(--muted); font-size: .82rem; padding-top: 4px; }
    .writing-item p { color: var(--muted); font-size: .9rem; margin: 0; max-width: 720px; }
    .writing-item:hover h3, .writing-item > span { color: var(--accent-strong); }
    .project-list { display: grid; gap: 24px; }
    .project-item { display: flex; align-items: center; gap: 26px; padding: 24px 0; border-bottom: 1px solid var(--line); }
    .project-item img { width: 220px; border-radius: 14px; }.project-item > div { flex: 1; }.project-item p { color: var(--muted); margin: 0; }
    .contact-links { display: flex; gap: 24px; color: var(--accent-strong); }
    .reveal { transition: opacity 500ms ease, transform 500ms ease; }
    @media (prefers-reduced-motion: no-preference) { .reveal:not(.is-visible) { opacity: .1; transform: translateY(15px); } }
    @media (max-width: 768px) {
      .hero-grid { grid-template-columns: 1fr; min-height: 0; padding: 108px 0 28px; gap: 12px; }
      h1 { font-size: clamp(2.4rem, 9vw, 4rem); }.hero-lead { font-size: .98rem; }.hero-eyebrow { margin-bottom: 16px; }
      .portrait-stage { height: 330px; }.hero-visual { max-width: 560px; width: 100%; margin-inline: auto; }
      .section-space { padding: 56px 0; }.about-grid, .skills-grid { grid-template-columns: 1fr; gap: 24px; }.skills-art { max-width: 560px; }
      .writing-item { grid-template-columns: 1fr 24px; gap: 10px; }.writing-item time { grid-column: 1; }.writing-item div { grid-column: 1 / -1; }.writing-item > span { grid-column: 2; grid-row: 1; }
      .project-item { flex-wrap: wrap; }.project-item img { width: 100%; }.project-item > div { flex-basis: 80%; }
      .section-heading { align-items: center; }.capability-list section { grid-template-columns: 100px minmax(0, 1fr); gap: 12px; }
    }
  </style>
</Layout>
